# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Must match INTERNAL_API_SECRET in backend/.env
INTERNAL_API_SECRET=change_this_to_a_random_secret_string

# "true" refuses private and internal addresses (the Dockerfile sets this).
# Leave unset locally so tests can run against localhost.
BLOCK_PRIVATE_URLS=
